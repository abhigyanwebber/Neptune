{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task",
  "type": "object",
  "required": [
    "task_id",
    "status",
    "created_at"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "parent_task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "created",
        "queued",
        "planning",
        "executing",
        "verifying",
        "paused",
        "completed",
        "failed",
        "cancelled",
        "suspended"
      ]
    },
    "constraints": {
      "type": "object"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
