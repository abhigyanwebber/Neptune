# Copy to .env (gitignored) and fill in real values. Never commit
# actual secrets. Neptune reads these from the process environment,
# not from this file directly -- use your shell, a secrets manager,
# or `python-dotenv` in local dev to load it.

# Required for GroqAdapter.invoke()/health() to reach a live model.
# Get a free key at https://console.groq.com/keys (no card required).
GROQ_API_KEY=

# Optional overrides (defaults shown):
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_TIMEOUT_SECONDS=30
